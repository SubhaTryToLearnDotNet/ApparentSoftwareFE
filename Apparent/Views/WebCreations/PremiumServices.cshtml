@{
    ViewBag.Title = "Premium Digital Services";
}

<section class="premium-services-page">
    <header class="premium-services-hero">
        <div class="container">
            <div class="premium-services-hero-grid">
                <div class="premium-services-hero-content">
                    <p class="premium-eyebrow">Bespoke digital partnerships</p>
                    <h1>Build the digital capability your business actually needs.</h1>
                    <p class="premium-lead">For ambitious teams that have outgrown off-the-shelf solutions, we design and deliver custom digital systems that fit the way your business works.</p>
                    <a href="/contact" class="btn btn-primary py-3 px-4">Start a private consultation</a>
                </div>
                <div class="premium-services-hero-image">
                    <img src="~/Content/WebCreation/img/carousel-1.jpg" alt="A custom digital platform designed for business growth" />
                </div>
            </div>
        </div>
    </header>

    <section class="premium-services-intro">
        <div class="container">
            <div class="premium-section-heading">
                <p class="premium-eyebrow">A considered process</p>
                <h2>From a difficult business problem to a durable digital advantage.</h2>
                <p>Our premium engagements bring strategy, design, engineering, automation and ongoing improvement together in one focused partnership.</p>
            </div>

            <div class="premium-process">
                <article class="premium-process-row">
                    <div class="premium-process-image">
                        <img src="~/Content/WebCreation/img/feature.jpg" alt="A team planning a custom digital solution" />
                    </div>
                    <div class="premium-process-content">
                        <span class="premium-step">01</span>
                        <p class="premium-eyebrow">Discover</p>
                        <h3>Understand what is holding your business back.</h3>
                        <p>We map your goals, customers, systems and operational friction. The result is a clear opportunity map, not a generic list of features.</p>
                        <a href="/contact" class="premium-next-step">Discuss your opportunity <i class="fa fa-arrow-right"></i></a>
                    </div>
                </article>

                <article class="premium-process-row premium-process-row-reverse">
                    <div class="premium-process-image">
                        <img src="~/Content/WebCreation/img/about.jpg" alt="A custom digital experience being shaped" />
                    </div>
                    <div class="premium-process-content">
                        <span class="premium-step">02</span>
                        <p class="premium-eyebrow">Design</p>
                        <h3>Shape an experience people can understand and use.</h3>
                        <p>We turn the strategy into a purposeful customer journey, visual direction and technical blueprint that your stakeholders can trust.</p>
                        <a href="/contact" class="premium-next-step">Review the direction <i class="fa fa-arrow-right"></i></a>
                    </div>
                </article>

                <article class="premium-process-row">
                    <div class="premium-process-image">
                        <img src="~/Content/WebCreation/img/carousel-1.jpg" alt="A high-performance website and business platform" />
                    </div>
                    <div class="premium-process-content">
                        <span class="premium-step">03</span>
                        <p class="premium-eyebrow">Build</p>
                        <h3>Engineer the platform around your real workflow.</h3>
                        <p>From premium websites and customer portals to automation, AI, CRM and ERP integrations, we build a dependable foundation that can evolve with you.</p>
                        <a href="/contact" class="premium-next-step">Plan the build <i class="fa fa-arrow-right"></i></a>
                    </div>
                </article>

                <article class="premium-process-row premium-process-row-reverse">
                    <div class="premium-process-image">
                        <img src="~/Content/WebCreation/img/carousel-2.jpg" alt="A digital product ready for launch and growth" />
                    </div>
                    <div class="premium-process-content">
                        <span class="premium-step">04</span>
                        <p class="premium-eyebrow">Grow</p>
                        <h3>Keep improving after the launch moment.</h3>
                        <p>We monitor performance, learn from real usage and make the next improvement easier. Your investment becomes a living business capability.</p>
                        <a href="/contact" class="premium-next-step">Create your growth plan <i class="fa fa-arrow-right"></i></a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="premium-services-cta">
        <div class="container">
            <div class="premium-cta-content">
                <p class="premium-eyebrow">Built around you</p>
                <h2>No fixed package. No borrowed blueprint.</h2>
                <p>Tell us where you want to go and we will create the right combination of strategy, design and technology to take you there.</p>
                <a href="/contact" class="btn btn-primary py-3 px-4">Request a tailored proposal</a>
            </div>
        </div>
    </section>
</section>

<style>
    .premium-services-page {
        color: #091e3e;
        background: #f8fcff;
    }

    .premium-services-hero {
        display: flex;
        align-items: center;
        padding: 72px 0;
        background: linear-gradient(135deg, #eef9ff 0%, #ffffff 68%, #e4f7fd 100%);
    }

    .premium-services-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
        gap: clamp(42px, 6vw, 88px);
        align-items: center;
    }

    .premium-services-hero-content {
        max-width: 680px;
    }

    .premium-eyebrow {
        margin-bottom: 14px;
        color: #06a3da;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .premium-services-hero h1,
    .premium-section-heading h2,
    .premium-cta-content h2 {
        margin-bottom: 20px;
        color: #091e3e;
        font-weight: 800;
        line-height: 1.12;
    }

    .premium-services-hero h1 {
        max-width: 680px;
        margin-bottom: 24px;
        font-size: clamp(2.5rem, 4.3vw, 4.6rem);
        letter-spacing: -.02em;
    }

    .premium-lead {
        max-width: 590px;
        margin-bottom: 30px;
        color: #526579;
        font-size: 1.08rem;
        line-height: 1.75;
    }

    .premium-services-hero-image {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: 8px;
        box-shadow: 0 18px 42px rgba(9, 30, 62, .15);
    }

    .premium-services-hero-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .premium-services-intro {
        padding: 100px 0 110px;
        background: #fff;
    }

    .premium-section-heading {
        max-width: 700px;
        margin: 0 auto 70px;
        text-align: center;
    }

    .premium-section-heading h2,
    .premium-cta-content h2 {
        font-size: clamp(2rem, 3.5vw, 3.3rem);
    }

    .premium-section-heading > p:last-child,
    .premium-cta-content > p:not(.premium-eyebrow) {
        color: #617286;
        line-height: 1.7;
    }

    .premium-process {
        display: flex;
        flex-direction: column;
        gap: 80px;
    }

    .premium-process-row {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
        gap: clamp(40px, 8vw, 120px);
        align-items: center;
    }

    .premium-process-row-reverse .premium-process-image {
        order: 2;
    }

    .premium-process-row-reverse .premium-process-content {
        order: 1;
    }

    .premium-process-image {
        min-height: 360px;
        overflow: hidden;
        background: #dff5fc;
        border-radius: 4px;
        box-shadow: 0 22px 55px rgba(9, 30, 62, .12);
    }

    .premium-process-image img {
        width: 100%;
        height: 100%;
        min-height: 360px;
        display: block;
        object-fit: cover;
    }

    .premium-process-content {
        position: relative;
        max-width: 500px;
    }

    .premium-step {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        color: #fff;
        background: #06a3da;
        border-radius: 50%;
        font-weight: 800;
    }

    .premium-process-content h3 {
        margin-bottom: 18px;
        color: #091e3e;
        font-size: clamp(1.6rem, 2.6vw, 2.4rem);
        font-weight: 800;
        line-height: 1.2;
    }

    .premium-process-content > p:not(.premium-eyebrow) {
        margin-bottom: 24px;
        color: #617286;
        line-height: 1.8;
    }

    .premium-next-step {
        color: #06a3da;
        font-weight: 700;
    }

    .premium-next-step:hover {
        color: #0582ae;
    }

    .premium-next-step i {
        margin-left: 8px;
    }

    .premium-services-cta {
        padding: 100px 0;
        background: #091e3e;
    }

    .premium-cta-content {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
    }

    .premium-cta-content h2 {
        color: #fff;
    }

    .premium-cta-content > p:not(.premium-eyebrow) {
        color: #c4d4e3;
        margin-bottom: 30px;
    }

    @@media (max-width: 767.98px) {
        .premium-services-hero {
            padding: 48px 0 56px;
        }

        .premium-services-hero-content {
            padding: 0;
        }

        .premium-services-hero-grid {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .premium-services-hero-image {
            width: 100%;
            margin-top: 8px;
            margin-bottom: 0;
        }

        .premium-services-intro,
        .premium-services-cta {
            padding: 70px 0;
        }

        .premium-section-heading {
            margin-bottom: 50px;
        }

        .premium-process {
            gap: 60px;
        }

        .premium-process-row,
        .premium-process-row-reverse {
            display: flex;
            flex-direction: column;
            gap: 30px;
            align-items: stretch;
        }

        .premium-process-row-reverse .premium-process-image,
        .premium-process-row-reverse .premium-process-content {
            order: initial;
        }

        .premium-process-image,
        .premium-process-image img {
            min-height: 260px;
        }
    }
</style>
